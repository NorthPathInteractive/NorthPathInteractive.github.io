{
  "buildCommand": "python3 build.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/projects/headspace/downloads/HEADSPACE-complete.zip",
      "headers": [
        {"key": "Content-Disposition", "value": "attachment; filename=HEADSPACE-complete.zip"},
        {"key": "Content-Type", "value": "application/zip"}
      ]
    },
    {
      "source": "/projects/headspace/audio/:path*",
      "headers": [{"key": "Content-Type", "value": "audio/mpeg"}]
    }
  ]
}
