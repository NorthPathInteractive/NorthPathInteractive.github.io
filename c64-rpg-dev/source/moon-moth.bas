10 REM MOON MOTH V0.1.0 - NORTH PATH INTERACTIVE
20 POKE 53280,6:POKE 53281,0:PRINT CHR$(147)
30 DIM G(3):SC=1024:CC=54272:HP=3:LV=1:TT=0
40 POKE CC+24,10:POKE CC+5,9:POKE CC+6,128
50 PRINT:PRINT "             MOON MOTH":PRINT "               V0.1.0"
60 PRINT:PRINT "   YOU ARE A SMALL LIGHT IN A BIG DREAM."
70 PRINT:PRINT "   COLLECT SIX STARS IN EACH GARDEN."
80 PRINT "   THREE GARDENS. THREE LITTLE HEARTS."
90 PRINT:PRINT "   W A S D : FLOAT     Q : LEAVE"
100 PRINT "   THE GARDEN WRAPS AROUND ITS EDGES."
110 PRINT "   SHADOWS MOVE ONLY WHEN YOU MOVE."
120 PRINT:PRINT "   NO CLOCK. TAKE YOUR TIME."
130 PRINT:PRINT "          SPACE TO DRIFT AWAY"
140 GET A$:IF A$<>" " THEN 140
150 RR=RND(-TI):GOTO 1000
200 GET A$:IF A$="" THEN 200
210 IF A$="Q" THEN POKE CC+4,0:PRINT CHR$(147):END
220 NX=X:NY=Y
230 IF A$="W" THEN NY=Y-1
240 IF A$="S" THEN NY=Y+1
250 IF A$="A" THEN NX=X-1
260 IF A$="D" THEN NX=X+1
270 IF NX=X AND NY=Y THEN 200
280 IF NX<10 THEN NX=29
290 IF NX>29 THEN NX=10
300 IF NY<4 THEN NY=18
310 IF NY>18 THEN NY=4
320 NP=SC+NY*40+NX
330 FOR I=1 TO LV:IF NP=G(I) THEN GOSUB 3000:GOTO 560
340 NEXT I
350 POKE P,46:POKE P+54272,6:X=NX:Y=NY:P=NP
360 IF PEEK(P)<>42 THEN 400
370 ST=ST+1:TT=TT+1:NN=20+ST*9:GOSUB 4000
380 IF ST=6 THEN LV=LV+1:IF LV>3 THEN 5000
390 IF ST=6 THEN HP=HP+1:IF HP>3 THEN HP=3
395 IF ST=6 THEN 1000
400 POKE P,81:POKE P+54272,7:MV=MV+1:GOSUB 2000
410 IF MV-INT(MV/2)*2<>0 THEN 200
420 FOR I=1 TO LV
430 O=G(I):D=INT(RND(1)*4):J=O
440 IF D=0 THEN J=O-40
450 IF D=1 THEN J=O+40
460 IF D=2 THEN J=O-1
470 IF D=3 THEN J=O+1
480 Z=INT((J-SC)/40):B=J-SC-Z*40
490 IF B<10 OR B>29 OR Z<4 OR Z>18 THEN 550
500 IF J=P THEN GOSUB 3000:GOTO 580
510 IF PEEK(J)<>46 THEN 550
520 POKE O,46:POKE O+54272,6:G(I)=J
530 POKE J,88:POKE J+54272,10
550 NEXT I:GOTO 200
560 IF HP=0 THEN 5100
570 GOTO 200
580 IF HP=0 THEN 5100
590 GOTO 550
1000 PRINT CHR$(147):ST=0:MV=0:POKE 53280,LV+3
1010 PRINT CHR$(19):PRINT " MOON MOTH V0.1.0"
1020 FOR Y=3 TO 19:FOR X=9 TO 30
1030 P=SC+Y*40+X:POKE P,160:POKE P+54272,LV+3
1040 IF X>9 AND X<30 AND Y>3 AND Y<19 THEN POKE P,46:POKE P+54272,6
1050 NEXT X:NEXT Y
1060 FOR I=1 TO LV:GOSUB 2500:G(I)=P:POKE P,88:POKE P+54272,10:NEXT I
1070 FOR K=1 TO 6:GOSUB 2500:POKE P,42:POKE P+54272,LV+4:NEXT K
1080 GOSUB 2500:POKE P,81:POKE P+54272,7
1090 PRINT CHR$(19);:FOR K=1 TO 21:PRINT CHR$(17);:NEXT
1100 PRINT "      W A S D: FLOAT   Q: LEAVE"
1110 PRINT "        * MOONLIGHT   X SHADOW"
1120 GOSUB 2000:GOTO 200
2000 PRINT CHR$(19);CHR$(17);" GARDEN";LV;"  LIGHT";ST;"/6  HEARTS";HP;" ":RETURN
2500 X=10+INT(RND(1)*20):Y=4+INT(RND(1)*15):P=SC+Y*40+X
2510 IF PEEK(P)<>46 THEN 2500
2520 RETURN
3000 HP=HP-1:NN=12:GOSUB 4000
3010 IF HP=0 THEN RETURN
3020 POKE P,46:POKE P+54272,6:GOSUB 2500
3030 POKE P,81:POKE P+54272,7:GOSUB 2000:RETURN
4000 POKE CC+1,NN:POKE CC,100:POKE CC+4,17
4010 FOR ZZ=1 TO 60:NEXT ZZ:POKE CC+4,16:RETURN
5000 PRINT CHR$(147):PRINT:PRINT "           THE MOON OPENS ITS EYE."
5010 PRINT:PRINT "   YOU BROUGHT ALL 18 LITTLE LIGHTS HOME."
5020 PRINT:PRINT "          THE GARDEN REMEMBERS YOU."
5030 GOTO 5200
5100 PRINT CHR$(147):PRINT:PRINT "        YOU DISSOLVE INTO SOFT COLOUR."
5110 PRINT:PRINT "       THE DREAM IS STILL HERE FOR YOU."
5120 PRINT:PRINT "       MOONLIGHT COLLECTED:";TT
5200 PRINT:PRINT "        SPACE: DREAM AGAIN   Q: LEAVE"
5210 GET A$:IF A$="Q" THEN POKE CC+4,0:END
5220 IF A$<>" " THEN 5210
5230 HP=3:LV=1:TT=0:GOTO 1000
